{
  "name": "innovation-ts",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "TypeScript port of Innovation: boardgame.io engine wrapped by the digital-boardgame-framework (web + async multiplayer). Ported from the Innovation.Core C# engine.",
  "scripts": {
    "build": "npm run gen-cards && tsc --noEmit && vite build",
    "typecheck": "npm run gen-cards && tsc --noEmit",
    "dev": "npm run gen-cards && vite",
    "smoke": "npm run gen-cards && vite-node scripts/smoke-rollout.ts",
    "test": "npm run gen-cards && vitest run",
    "gen-cards": "node scripts/build-card-data.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "boardgame.io": "^0.50.2",
    "digital-boardgame-framework": "^0.42.0",
    "html2canvas": "^1.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260603.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.6.0",
    "vite": "^8.0.12",
    "vite-node": "^6.0.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.97.0"
  }
}
